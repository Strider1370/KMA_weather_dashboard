{
  "name": "aviation-weather-collector",
  "version": "1.0.0",
  "description": "KMA aviation weather data collection service",
  "main": "backend/src/index.js",
  "scripts": {
    "start": "node backend/src/index.js",
    "test": "node backend/test/run-once.js all",
    "dashboard": "node server.js",
    "dev": "concurrently -n API,VITE -c blue,green \"node server.js\" \"npm run dev --prefix frontend\"",
    "geo:sido": "node scripts/generate-sido-geojson.js",
    "geo:sigungu": "node scripts/generate-sigungu-geojson.js",
    "geo:topo": "node scripts/generate-boundary-topojson.js",
    "geo:neighbors": "node scripts/extract-neighbors-only-geojson.js"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "fast-xml-parser": "^4.3.0",
    "node-cron": "^3.0.3",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@turf/union": "^7.3.4",
    "concurrently": "^9.2.1",
    "topojson-server": "^3.0.1"
  }
}
